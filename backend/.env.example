# =============================================================================
# AIOps Agent Platform - 环境变量模板
# =============================================================================
# 用法：在 backend/ 目录下执行 cp .env.example .env，然后按需修改。
# .env 已被 .gitignore 忽略，不要提交到仓库。
#
# 本文件只列出会从 .env 读取的变量。.env 由 pydantic-settings 按当前工作目录
# 加载，所以后端必须在 backend/ 目录下启动。
# 所有变量都有默认值，不创建 .env 也能以规则引擎模式启动。
# =============================================================================

# ---------- 应用 ----------
# 运行环境：development | testing | staging | production
# 非 development 时 /docs、/redoc、/openapi.json 会关闭
APP_ENV=development
# 监听地址和端口（python -m app.main 启动时生效）
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=false
# 允许跨域的前端地址，JSON 数组格式
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------- LLM ----------
# provider：openai | deepseek | ollama | mimimax | anthropic
#   openai / deepseek / ollama / mimimax 走 OpenAI 兼容协议
#   anthropic 需要额外安装 langchain-anthropic（requirements.txt 未包含）
LLM_PROVIDER=openai
# 留空 = 规则引擎模式，所有 LLM 调用自动降级到规则 fallback
LLM_API_KEY=
# 自定义 OpenAI 兼容端点；mimimax 和 ollama 必填，deepseek 留空时默认 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# token 单价（USD / 1k tokens），用于成本统计；0 表示只记 token 数
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0

# ---------- Langfuse 链路追踪（可选） ----------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_RELEASE=1.0.0
LANGFUSE_ENVIRONMENT=development

# ---------- Agent 行为 ----------
# RCA 结论被视为"高置信"的最低置信度
AGENT_RCA_MIN_CONFIDENCE=0.7
# 主链路 RCA 合成优化开关（也可用进程环境变量 AIOPS_USE_RCA_V2 覆盖）
AGENT_RCA_V2_ENABLED=false
# 调查验证闭环开关（候选验证 / 反证 / 重规划）
AGENT_VERIFICATION_ENABLED=false

# ---------- 记忆系统 ----------
MEMORY_SHORT_TERM_MAX_ITEMS=100
MEMORY_SIMILARITY_THRESHOLD=0.85
MEMORY_RETENTION_DAYS=90

# ---------- WebSocket ----------
WS_HEARTBEAT_INTERVAL_SECONDS=30

# =============================================================================
# 以下变量由代码通过 os.getenv 读取，写在 .env 里不会生效，
# 需要在启动命令前 export 或写在命令行前缀，例如：
#   PROMETHEUS_URL=http://localhost:9090 python -m app.main
#
# PROMETHEUS_URL=http://localhost:9090     Prometheus 地址，不可达时降级
# LOKI_URL=http://localhost:3100           Loki 日志地址，不可达时降级
# AIOPS_FORCE_FALLBACK=1                   强制评测和自进化不调用 LLM
# AIOPS_USE_RCA_V2=true                    同 AGENT_RCA_V2_ENABLED，优先级更高
# AIOPS_USE_W8_1_AUDIT=false               主链路审计
# AIOPS_USE_W8_2_GATE=false                主链路门禁
# AIOPS_USE_W8_3_CONTEXT=false             决策上下文
# AIOPS_USE_W8_4_CORRELATE=false           多告警关联
# EVAL_HISTORY_DB_PATH=                    评测历史库路径，默认 ../data/eval_history/history.db
# EVAL_BASELINES_DIR=                      评测 baseline 目录
# =============================================================================
